{
  "name": "Terraform",
  "scopeName": "source.terraform",
  "type": "tree-sitter",
  "parser": "tree-sitter-terraform",
  "injectionNames": ["terraform", "tf"],
  "fileTypes": ["tf", "tfvars"],
  "comments": {
    "start": "# "
  },
  "treeSitter": {
    // Terraform is a dialect of HCL living in a subdirectory of the same
    // upstream repository, so it is a separate parser and needs its own wasm;
    // one shared build would install one over the other.
    "parserSource": "github:MichaHoffmann/tree-sitter-hcl/dialects/terraform#v1.2.0",
    "wasmBuildTool": "tree-sitter-cli#v0.26.13",
    "grammar": "terraform.wasm",
    "highlightsQuery": ["terraform-hcl-highlights.scm", "terraform-highlights.scm"],
    "foldsQuery": "terraform-folds.scm",
    "indentsQuery": "terraform-indents.scm",
    "tagsQuery": "terraform-tags.scm"
  }
}
