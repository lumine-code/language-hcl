{
  ".source.hcl, .source.terraform": {
    "bracket-matcher": {
      "autocompleteCharacters": ["()", "[]", "{}", "\"\""]
    },
    "editor": {
      "commentStart": "# ",
      "commentDelimiters": {
        "line": "#",
        "block": ["/*", "*/"]
      },
      "nonWordCharacters": "/\\()\"':,.;<>~!@#$%^&*|+=[]{}`?…"
    }
  }
}
